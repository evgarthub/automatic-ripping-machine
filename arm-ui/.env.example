# Leave empty to use same origin (e.g. Vite dev server with /api proxied to ARM).
# Set to full ARM URL when the API is on another host (no proxy).
# VITE_ARM_API_BASE=http://127.0.0.1:8080

# Backend for Vite proxy (only used by vite.config.ts, not exposed to the bundle).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# Windows ARM64 (Node reports process.arch === 'arm64'): if `npm run build` errors
# with "Cannot find module @rollup/rollup-win32-arm64-msvc", run:
#   npm install @rollup/rollup-win32-arm64-msvc@4.60.3
# (version must match the `rollup` version used by Vite; see `npm ls rollup`.)
